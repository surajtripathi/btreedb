# Binaries and build output
/kvcli
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test / build artifacts
*.test
*.out
*.prof
*.pprof
/coverage.txt

# Runtime data generated by the store itself - this is what your
# program writes to disk when it runs, not source code.
*.wal
*.wal.tmp
data.wal
sstable/
*.sst
*.sst.tmp

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS cruft
.DS_Store
Thumbs.db

# Go workspace files (only relevant if you start using multi-module workspaces)
go.work
go.work.sum

# Env files, in case you ever add config/secrets later
.env